{
  "compilerOptions": {
    "target": "ES2020",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./*"],
      "next/link": ["./src/compat/next-link.tsx"],
      "next/dynamic": ["./src/compat/next-dynamic.tsx"],
      "next/image": ["./src/compat/next-image.tsx"]
    }
  },
  "include": [
    "src",
    "components/Dashboard.tsx",
    "components/SidebarLayout.tsx",
    "components/anime/**/*.tsx",
    "components/dashboard/**/*.tsx",
    "components/shared/ConfirmDialog.tsx",
    "components/shared/ErrorBoundary.tsx",
    "components/shared/EmptyState.tsx",
    "components/shared/LazyRender.tsx",
    "components/shared/Skeleton.tsx",
    "components/shared/Toast.tsx",
    "components/theme/ThemeProvider.tsx",
    "app/anime/AnimePagination.tsx",
    "app/anime/AnimeSidebar.tsx",
    "app/anime/anime-page-helpers.ts",
    "hooks/useAnimeData.ts",
    "hooks/useHistoryData.ts",
    "lib/anime-cast.ts",
    "lib/anime-shared.ts",
    "lib/anime-provider.ts",
    "lib/client-api.ts",
    "lib/config.ts",
    "lib/dashboard-types.ts",
    "lib/date-utils.ts",
    "lib/formatters.ts",
    "lib/hooks-shared.ts",
    "lib/theme.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
